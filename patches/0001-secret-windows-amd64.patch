diff --git a/src/runtime/secret/secret_windows_test.go b/src/runtime/secret/secret_windows_test.go
new file mode 100644
index 0000000000..e1bd93ca9d
--- /dev/null
+++ b/src/runtime/secret/secret_windows_test.go
@@ -0,0 +1,76 @@
+// Copyright 2025 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build goexperiment.runtimesecret && amd64 && !race && !asan && !msan
+
+package secret
+
+import (
+	"runtime"
+	"syscall"
+	"testing"
+	"unsafe"
+)
+
+// TestExceptionStacks is the Windows counterpart of TestSignalStacks.
+// A fault inside Do makes the kernel write the register state onto the
+// goroutine stack and runs the Go exception handler on g0. After Do returns,
+// neither the goroutine stack nor any g0 stack may hold the secret.
+func TestExceptionStacks(t *testing.T) {
+	Do(func() {
+		s := makeS()
+		loadRegisters(unsafe.Pointer(&s))
+		func() {
+			defer func() {
+				if recover() == nil {
+					panic("did not get panic")
+				}
+			}()
+			var p *int
+			*p = 20
+		}()
+	})
+	checkStackForSecret(t)
+	stk := make([]stack, 0, 100)
+	stk = appendSystemStacks(stk)
+	if len(stk) == 0 {
+		t.Fatal("no system stacks reported")
+	}
+	for _, s := range stk {
+		// g0 stacks are OS thread stacks; only their committed pages are
+		// readable.
+		for _, r := range committedRanges(s.lo, s.hi) {
+			checkRangeForSecret(t, r[0], r[1])
+		}
+	}
+}
+
+var procVirtualQuery = syscall.NewLazyDLL("kernel32.dll").NewProc("VirtualQuery")
+
+// committedRanges returns the committed, non-guard parts of [lo, hi).
+func committedRanges(lo, hi uintptr) (out [][2]uintptr) {
+	type memoryBasicInformation struct {
+		baseAddress, allocationBase    uintptr
+		allocationProtect, partitionID uint32
+		regionSize                     uintptr
+		state, protect, typ, _         uint32
+	}
+	const memCommit, pageGuard, pageNoAccess = 0x1000, 0x100, 0x01
+	for a := lo; a < hi; {
+		var m memoryBasicInformation
+		r, _, _ := procVirtualQuery.Call(a, uintptr(unsafe.Pointer(&m)), unsafe.Sizeof(m))
+		if r == 0 {
+			break
+		}
+		end := min(m.baseAddress+m.regionSize, hi)
+		if m.state == memCommit && m.protect&(pageGuard|pageNoAccess) == 0 {
+			out = append(out, [2]uintptr{max(a, m.baseAddress), end})
+		}
+		a = end
+	}
+	_ = runtime.GOOS
+	return out
+}
+
+func appendSystemStacks([]stack) []stack
