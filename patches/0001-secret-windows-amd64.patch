diff --git a/src/runtime/secret_signal_unix.go b/src/runtime/secret_signal_unix.go
new file mode 100644
index 0000000000..dafee3132e
--- /dev/null
+++ b/src/runtime/secret_signal_unix.go
@@ -0,0 +1,55 @@
+// Copyright 2024 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build (amd64 || arm64 || loong64) && linux
+
+package runtime
+
+import "unsafe"
+
+// erase any secrets that may have been spilled onto the signal stack during
+// signal handling. Must be called on g0 or inside STW to make sure we don't
+// get rescheduled onto a different M.
+//
+//go:nosplit
+func eraseSecretsSignalStk() {
+	mp := getg().m
+	if mp.signalSecret {
+		mp.signalSecret = false
+		// signal handlers get invoked atomically
+		// so it's fine for us to zero out the stack while a signal
+		// might get delivered. Worst case is we are currently running
+		// in secret mode and the signal spills fresh secret info onto
+		// the stack, but since we haven't returned from the secret.Do
+		// yet, we make no guarantees about that information.
+		//
+		// It might be tempting to only erase the part of the signal
+		// stack that has the context, but when running with forwarded
+		// signals, they might pull arbitrary data out of the context and
+		// store it elsewhere on the stack. We can't stop them from storing
+		// the data in arbitrary places, but we can erase the stack where
+		// they are likely to put it in cases of a register spill.
+		size := mp.gsignal.stack.hi - mp.gsignal.stack.lo
+		memclrNoHeapPointers(unsafe.Pointer(mp.gsignal.stack.lo), size)
+	}
+}
+
+// return a slice of all Ms signal stacks
+// For testing only.
+//
+//go:linkname secret_appendSignalStacks runtime/secret.appendSignalStacks
+func secret_appendSignalStacks(sigstacks []stack) []stack {
+	// This is probably overkill, but it's what
+	// doAllThreadsSyscall does
+	stw := stopTheWorld(stwAllThreadsSyscall)
+	allocmLock.lock()
+	acquirem()
+	for mp := allm; mp != nil; mp = mp.alllink {
+		sigstacks = append(sigstacks, mp.gsignal.stack)
+	}
+	releasem(getg().m)
+	allocmLock.unlock()
+	startTheWorld(stw)
+	return sigstacks
+}
diff --git a/src/runtime/secret_signal_windows.go b/src/runtime/secret_signal_windows.go
new file mode 100644
index 0000000000..9a9d457487
--- /dev/null
+++ b/src/runtime/secret_signal_windows.go
@@ -0,0 +1,50 @@
+// Copyright 2025 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build amd64 && windows
+
+package runtime
+
+import _ "unsafe"
+
+// Windows has no signal stacks: mpreinit does not allocate mp.gsignal, and
+// exceptions are dispatched on the faulting thread's current stack. When a
+// goroutine faults inside secret.Do, the kernel writes the exception record
+// and CONTEXT (including the full register state) below the goroutine's
+// SP, on the goroutine stack, and the Go exception handler runs on g0 after
+// a systemstack switch, which erases registers in secret mode. Everything
+// the kernel wrote therefore lies in [stack.lo, sp) and is cleared by
+// secret_eraseSecrets when Do returns. There is nothing to erase here.
+//
+//go:nosplit
+func eraseSecretsSignalStk() {}
+
+// return a slice of all Ms signal stacks. There are none on Windows.
+// For testing only.
+//
+//go:linkname secret_appendSignalStacks runtime/secret.appendSignalStacks
+func secret_appendSignalStacks(sigstacks []stack) []stack {
+	return sigstacks
+}
+
+// secret_appendSystemStacks returns the g0 stack of every M. The Windows
+// exception handler runs on g0, so the Windows test that faults inside
+// secret.Do checks these for residue.
+// For testing only.
+//
+//go:linkname secret_appendSystemStacks runtime/secret.appendSystemStacks
+func secret_appendSystemStacks(stacks []stack) []stack {
+	stw := stopTheWorld(stwAllThreadsSyscall)
+	allocmLock.lock()
+	acquirem()
+	for mp := allm; mp != nil; mp = mp.alllink {
+		if mp.g0 != nil && mp.g0.stack.lo != 0 {
+			stacks = append(stacks, mp.g0.stack)
+		}
+	}
+	releasem(getg().m)
+	allocmLock.unlock()
+	startTheWorld(stw)
+	return stacks
+}
