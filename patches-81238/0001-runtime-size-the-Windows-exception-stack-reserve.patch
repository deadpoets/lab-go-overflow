+// exceptionStackReserve returns how many bytes Windows may write below a
+// goroutine's stack pointer when it dispatches an exception on that stack.
+// Windows has no alternate signal stack, and the CONTEXT it pushes grows
+// with the extended CPU state the OS enabled: under 2 KiB on most CPUs,
+// over 11 KiB with AMX. See issue 81238.
+func exceptionStackReserve() uintptr {
+	// The EXCEPTION_RECORD, the kernel's alignment, and the frames below
+	// the CONTEXT until sigtrampgo switches to g0. Measured up to sigtramp
+	// at up to 913 bytes on amd64, 1087 on arm64 and 309 on 386.
+	const dispatchOverhead = 2048
+
+	n, errno := initializeContextSize(windows.CONTEXT_ALL | windows.CONTEXT_XSTATE)
+	switch {
+	case errno == windows.ERROR_INVALID_PARAMETER && GOARCH == "arm64":
+		// CONTEXT_XSTATE is not defined on this Windows version. All
+		// supported versions of Windows for 386 and amd64 define it, but
+		// arm64 doesn't until Windows 11 24H2.
+		fallthrough
+	case errno == windows.ERROR_NOT_SUPPORTED:
+		// No extended state.
+		n, errno = initializeContextSize(windows.CONTEXT_ALL)
+	}
+	if errno != 0 {
+		print("runtime: InitializeContext failed; errno=", errno, "\n")
+		throw("InitializeContext failed")
+	}
+	return uintptr(n) + dispatchOverhead
+}
+
+// initializeContextSize returns the size of a CONTEXT with the given flags.
+func initializeContextSize(contextFlags uint32) (n uint32, errno uint32) {
+	// With a nil buffer, InitializeContext fails with
+	// ERROR_INSUFFICIENT_BUFFER and returns the size of the CONTEXT.
+	stdcall(_InitializeContext, 0, uintptr(contextFlags), 0, uintptr(unsafe.Pointer(&n)))
+	if errno = getlasterror(); errno != windows.ERROR_INSUFFICIENT_BUFFER {
+		return 0, errno
+	}
+	return n, 0
+}
