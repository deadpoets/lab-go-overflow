+
+// StackHeadroom returns the bytes between the caller's SP and the bottom
+// of its stack. It is nosplit so that calling it cannot grow the stack.
+//
+//go:nosplit
+func StackHeadroom() uintptr {
+	return sys.GetCallerSP() - getg().stack.lo
+}
+
+// StackSize returns the size of the caller's stack. It is nosplit for the
+// same reason as StackHeadroom.
+//
+//go:nosplit
+func StackSize() uintptr {
+	gp := getg()
+	return gp.stack.hi - gp.stack.lo
+}
