+// TestExceptionStackReserve checks that the per-stack OS reserve covers the
+// CONTEXT the kernel pushes when it dispatches an exception on a goroutine
+// stack, and that the stack guard and minimum stack allocation moved with it.
+// See issue 81238.
+func TestExceptionStackReserve(t *testing.T) {
+	kernel32, err := syscall.LoadDLL("kernel32.dll")
+	if err != nil {
+		t.Fatal(err)
+	}
+	initializeContext, err := kernel32.FindProc("InitializeContext")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Same query and error handling as exceptionStackReserve.
+	contextSize := func(flags uintptr) (n uint32, errno syscall.Errno) {
+		_, _, e := initializeContext.Call(0, flags, 0, uintptr(unsafe.Pointer(&n)))
+		if errno = e.(syscall.Errno); errno != runtime.ErrorInsufficientBuffer {
+			return 0, errno
+		}
+		return n, 0
+	}
+	flags := uintptr(runtime.ContextAllXState)
+	n, errno := contextSize(flags)
+	switch {
+	case errno == runtime.ErrorInvalidParameter && runtime.GOARCH == "arm64":
+		fallthrough
+	case errno == runtime.ErrorNotSupported:
+		flags = runtime.ContextAll
+		n, errno = contextSize(flags)
+	}
+	if errno != 0 {
+		t.Fatalf("InitializeContext(%#x): %v", flags, errno)
+	}
+	exceptionRecord := uintptr(152)
+	if runtime.GOARCH == "386" {
+		exceptionRecord = 80
+	}
+	system, guard, fixed := runtime.StackSystem(), runtime.StackGuard(), runtime.FixedStack()
+	t.Logf("InitializeContext(%#x) = %d bytes; stackSystem = %d, stackGuard = %d, fixedStack = %d",
+		flags, n, system, guard, fixed)
+	if system < uintptr(n)+exceptionRecord {
+		t.Errorf("stackSystem %d cannot hold a %d-byte CONTEXT and a %d-byte EXCEPTION_RECORD", system, n, exceptionRecord)
+	}
+	if system < 4096 {
+		t.Errorf("stackSystem %d is below the 4096-byte floor", system)
+	}
+	if guard < system {
+		t.Errorf("stackGuard %d is below stackSystem %d", guard, system)
+	}
+	if fixed <= guard {
+		t.Errorf("fixedStack %d is not above stackGuard %d", fixed, guard)
+	}
+}
